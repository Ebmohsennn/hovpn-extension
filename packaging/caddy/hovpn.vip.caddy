
# ═══════════════════════════════════════════════════════════════════════════════
#  hovpn.vip · Hovpn extension site (static)
#  A CDN fronts hovpn.vip and terminates public TLS; it reaches this origin over
#  plain HTTP. Served HTTP-only (no origin cert). The
#  explicit bind makes this site claim the HTTP listener so it serves content
#  instead of being caught by the automatic HTTP->HTTPS redirect.
# ═══════════════════════════════════════════════════════════════════════════════
http://hovpn.vip {
	# Replace ORIGIN_IP with the server's own address when deploying. Keep the real
	# address out of this repository, and firewall this listener to the CDN's ranges.
	bind {$ORIGIN_IP} 127.0.0.1

	encode zstd gzip

	root * /var/www/hovpn.vip/public_html

	@dotfiles {
		path /.* /.*/*
		not path /.well-known/*
	}
	respond @dotfiles 404

	# clean URLs: /support -> support.html, /privacy -> privacy.html, etc.
	try_files {path} {path}.html {path}/ =404
	file_server

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The site is static: no scripts, forms, frames or third-party resources.
		Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}
	# force downloads for helper installers
	header /download/* Content-Disposition "attachment"
}
