{
  "manifest_version": 3,
  "name": "Hovpn",
  "version": "1.0.0",
  "description": "Hovpn — secure, elegant proxy for Chrome. Import your config or subscription and route only Chrome's traffic.",
  "author": "Mohsen (ebmohsen.com)",
  "homepage_url": "https://hovpn.vip",
  "permissions": ["proxy", "storage", "nativeMessaging", "alarms", "notifications"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "V2Ray Proxy",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html"
}
