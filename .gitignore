# OS / editor
.DS_Store
*.swp
*~

# Node
node_modules/

# Generated by native-host/install.sh (machine-specific absolute paths)
native-host/xray-manager-host

# Never commit credentials or secrets of any kind
*.pem
*.key
keys/hovpn-private-key.pem
*service-account*.json
*credentials*.json
*client_secret*.json
secrets/
.env
.env.*

# Runtime state (created at ~/.v2ray-chrome-ext, but guard anyway)
*.log
xray-config.json
state.json

# Build artifacts
*.zip
dist/

# Packaging: large bundled binaries + build outputs (reproduce via
# packaging/mac/fetch-binaries.sh; not committed to keep the repo light)
packaging/mac/scripts/node-*
packaging/mac/scripts/xray-*
packaging/mac/scripts/hovpn-host.js
packaging/mac/build/
packaging/mac/out/
packaging/store/build/
packaging/store/*.zip

# Signing / key material
keys/hovpn-private-key.pem

# Signed extension package (rebuildable)
*.crx
